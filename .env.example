# --- Base de datos ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/huella
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/huella_test

# --- Servidor ---
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- Zona horaria por defecto (RNF-02) ---
DEFAULT_TIMEZONE=America/Mexico_City

# --- De dónde cuelga el enlace de alta que se le manda a la clienta ---
# En desarrollo se deduce de la petición; en producción hay que fijarla,
# porque detrás de un proxy el host de la petición no es el público.
# URL_PUBLICA=https://huella.mx

# --- Cifrado en reposo de datos sensibles (RNF-06) ---
# 32 bytes en base64: `openssl rand -base64 32`
ENCRYPTION_KEY=

# --- WhatsApp Business API (seccion 08) ---
# El proveedor concreto se inyecta por adaptador; en desarrollo se usa el falso.
WHATSAPP_DRIVER=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Almacenamiento de documentos (carnet, RF-16) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- Cobros recurrentes (RF-23) ---
BILLING_DRIVER=fake
BILLING_TRIAL_DAYS=14
BILLING_MONTHLY_PRICE_MXN=149

# Leer el carnet solo (Claude).
# 'auto' lee si hay llave y ofrece captura a mano si no. Cuesta unos centavos
# por carnet: con 20 clientas de piloto son un par de dólares en total.
CARNET_DRIVER=auto
ANTHROPIC_API_KEY=
